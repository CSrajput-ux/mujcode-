# ==============================================================================
# MujCode — Production Environment Variables
# ==============================================================================
# HOW TO USE:
#   1. Copy this file:  cp .env.example .env
#   2. Fill in all values marked with <...>
#   3. NEVER commit .env to git (it's already in .gitignore)
# ==============================================================================

# ── Server ─────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=5000
HOST=0.0.0.0

# Ports exposed on the HOST machine (change if 80/5000 are taken)
FRONTEND_PORT=80
BACKEND_PORT=5000

# ── Security (REQUIRED) ────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_SECRET=<your-32-byte-hex-secret-here>

# Set to your production domain. Use * only for testing.
# Example: https://mujcode.yourdomain.com
CORS_ORIGIN=*

# ── PostgreSQL (REQUIRED) ──────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=<strong-database-password>
POSTGRES_DB=mujcode_db
# If using Neon/Supabase/external PostgreSQL, paste the full connection string:
POSTGRES_URI=postgres://postgres:<strong-database-password>@postgres:5432/mujcode_db

# ── Redis ─────────────────────────────────────────────────────────────────────
# Leave as-is for Docker Compose internal Redis
REDIS_URI=redis://redis:6379

# ── MongoDB (only needed for ATS/Placement module) ────────────────────────────
MONGO_PASSWORD=<strong-mongo-password>
MONGODB_URI=mongodb://root:<strong-mongo-password>@mongodb:27017/mujcode_ats?authSource=admin

# ── Cloudinary (for file uploads: PDFs, PPTs, images) ────────────────────────
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_CLOUD_NAME=<cloud_name>
CLOUDINARY_API_KEY=<api_key>
CLOUDINARY_API_SECRET=<api_secret>

# ── Judge0 Code Execution Engine ──────────────────────────────────────────────
# Internal Docker URL (use this when running Judge0 via docker compose --profile judge0)
JUDGE0_URL=http://judge0_server:2358
# External Judge0 (use this if you have a remote Judge0 instance):
# JUDGE0_URL=https://your-judge0-instance.com
JUDGE0_AUTH_TOKEN=
JUDGE0_CPU_TIME_LIMIT=2
JUDGE0_MEMORY_LIMIT=128000
JUDGE0_WALL_TIME_LIMIT=5

# ── Frontend API URL ───────────────────────────────────────────────────────────
# Leave EMPTY when running everything with docker-compose (nginx handles routing)
# Set to external URL ONLY for platforms like Render, Vercel, Railway:
# VITE_API_URL=https://your-backend.onrender.com
VITE_API_URL=
