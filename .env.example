# ==============================================================================
# 🚀 MujCode Root Environment Configuration (.env.example)
# ==============================================================================
# Copy this file to .env before starting Docker Compose or deploying:
#   cp .env.example .env
# ==============================================================================

# ── General Server Settings ────────────────────────────────────────────────────
PORT=5000
HOST=0.0.0.0
NODE_ENV=production

# ── Security & Authentication ──────────────────────────────────────────────────
# CRITICAL: Generate a strong secret in production using: openssl rand -hex 32
TOKEN_SECRET=change-this-to-a-secure-random-32-byte-hex-secret-in-production

# ── CORS Settings ─────────────────────────────────────────────────────────────
# Set to your production frontend domain (e.g., https://mujcode.example.com)
CORS_ORIGIN=*

# ── Primary Database: PostgreSQL (ACID + JSONB Collections) ───────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=mujcode_db
POSTGRES_URI=postgres://postgres:postgres@postgres:5432/mujcode_db

# ── Local File Snapshot & Uploads ─────────────────────────────────────────────
# In-Memory Fast JSON DB backup snapshot path (inside container: /app/src/data/db.json)
DB_FILE=/app/src/data/db.json
UPLOAD_DIR=/app/uploads

# Redis connection string for caching, WebSockets, and Judge0 queues
REDIS_URI=redis://redis:6379

# MongoDB password and connection string (Required for ATS / Placement Drives module)
MONGO_PASSWORD=change_mongo_root_password_here
MONGODB_URI=mongodb://root:change_mongo_root_password_here@mongodb:27017/mujcode_ats?authSource=admin

# ── Self-Hosted Judge0 CE Configuration ──────────────────────────────────────
# Internal API URL for the sandboxed execution engine
JUDGE0_URL=http://judge0_server:2358
JUDGE0_AUTH_TOKEN=

# Default execution resource constraints
JUDGE0_CPU_TIME_LIMIT=2
JUDGE0_MEMORY_LIMIT=128000
JUDGE0_WALL_TIME_LIMIT=5

# ── Cloudinary Cloud Storage (for PPT, PDF, Images, Documents) ───────────────
# Option A: Full Connection URL
CLOUDINARY_URL=
# Option B: Individual API Keys
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Frontend Build Configuration (Optional) ───────────────────────────────────
# If empty, frontend automatically uses relative API endpoints via NGINX reverse proxy.
# For remote backend deployment (e.g. Render/Vercel):
VITE_API_URL=https://mujcode-1.onrender.com
