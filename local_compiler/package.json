{
  "name": "mujcode-local-compiler",
  "version": "1.0.0",
  "description": "MUJCODE Local Compiler Desktop Agent — Secure, multi-language execution bridge for Windows",
  "author": "MUJCODE Engineering Team",
  "license": "MIT",
  "type": "module",
  "main": "dist/main/index.js",
  "scripts": {
    "build:assets": "node scripts/buildAssets.js",
    "build": "tsc && npm run build:assets",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.ts",
    "dev:doctor": "node -e \"import('./dist/services/runtimeDoctor.js').then(m => m.runtimeDoctor.diagnoseAll().then(r => console.log(JSON.stringify(r, null, 2))))\"",
    "start": "npm run build && electron .",
    "pack:win": "npm run build && electron-builder --win --dir",
    "dist:win": "npm run build && electron-builder --win"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "socket.io-client": "^4.8.1",
    "sql.js": "^1.15.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/sql.js": "^1.4.11",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "typescript": "^5.8.0"
  },
  "build": {
    "appId": "com.mujcode.localcompiler",
    "productName": "MUJCODE Local Compiler",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "assets/**/*",
      "package.json"
    ],
    "extraMetadata": {
      "main": "dist/main/index.js"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "artifactName": "MUJCODE-Local-Compiler-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": false,
      "createStartMenuShortcut": true,
      "shortcutName": "MUJCODE Local Compiler",
      "uninstallDisplayName": "MUJCODE Local Compiler",
      "deleteAppDataOnUninstall": true
    }
  }
}
