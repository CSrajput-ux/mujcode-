# ==============================================================================
# Judge0 CE (v1.13.1) Environment Configuration Template
# ==============================================================================
# Generate strong, random secrets for production deployment.
# Run: openssl rand -hex 32
# ==============================================================================

# ── PostgreSQL Database Credentials ───────────────────────────────────────────
POSTGRES_USER=judge0
POSTGRES_PASSWORD=generate_strong_password_here_via_openssl_rand_hex_32
POSTGRES_DB=judge0
POSTGRES_HOST=judge0_db
POSTGRES_PORT=5432

# ── Redis Queue & Cache Credentials ───────────────────────────────────────────
REDIS_PASSWORD=generate_strong_password_here_via_openssl_rand_hex_32
REDIS_HOST=judge0_redis
REDIS_PORT=6379

# ── Sandbox Security & Resource Limits ────────────────────────────────────────
ENABLE_NETWORK=false
ENABLE_PER_PROCESS_AND_THREAD_TIME_LIMIT=true
ENABLE_PER_PROCESS_AND_THREAD_MEMORY_LIMIT=true

# CPU Time Limits (Seconds)
CPU_TIME_LIMIT=2.0
MAX_CPU_TIME_LIMIT=5.0
CPU_EXTRA_TIME=0.5

# Wall-clock Real Time Limits (Seconds)
WALL_TIME_LIMIT=5.0
MAX_WALL_TIME_LIMIT=10.0

# Memory Limits (KB) — 128MB Default, 256MB Max
MEMORY_LIMIT=128000
MAX_MEMORY_LIMIT=256000

# Stack Limits (KB) — 64MB Default, 128MB Max
STACK_LIMIT=64000
MAX_STACK_LIMIT=128000

# Process & Thread Limits per Sandbox Execution
MAX_PROCESSES_AND_OR_THREADS=64
MAX_MAX_PROCESSES_AND_OR_THREADS=128

# Maximum Output / File Size (KB) — 1024KB (1MB)
MAX_FILE_SIZE=1024
MAX_MAX_FILE_SIZE=4096

# Number of Execution Runs
NUMBER_OF_RUNS=1
MAX_NUMBER_OF_RUNS=1

# ── API Gateway Configuration ─────────────────────────────────────────────────
BASE_URL=/
ENABLE_WAIT_RESULT=false
ENABLE_COMPILER_OPTIONS=false
ENABLE_COMMAND_LINE_ARGUMENTS=false
ENABLE_SUBMISSION_DELETE=false
ENABLE_CALLBACKS=false

# ── Optional Token Authentication ─────────────────────────────────────────────
# Set AUTH_TOKEN if backend communicates with Judge0 using X-Auth-Token header
# AUTH_TOKEN=generate_strong_secret_token_here
