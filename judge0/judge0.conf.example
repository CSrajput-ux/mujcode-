# ==============================================================================
# Judge0 CE Configuration Template
# ==============================================================================
# Copy this file to judge0.conf and generate strong random passwords for production.
# NEVER commit judge0.conf to version control.
# ==============================================================================

# ── PostgreSQL Database ───────────────────────────────────────────────────────
POSTGRES_USER=judge0
POSTGRES_PASSWORD=CHANGE_THIS_TO_A_SECURE_RANDOM_PASSWORD_FOR_POSTGRES
POSTGRES_DB=judge0
POSTGRES_HOST=judge0-db
POSTGRES_PORT=5432

# ── Redis Cache & Queue ───────────────────────────────────────────────────────
REDIS_PASSWORD=CHANGE_THIS_TO_A_SECURE_RANDOM_PASSWORD_FOR_REDIS
REDIS_HOST=judge0-redis
REDIS_PORT=6379

# ── Resource Limits & Sandbox Security ───────────────────────────────────────
# Default CPU time limit per submission (seconds)
CPU_TIME_LIMIT=2
# Maximum CPU time limit allowed (seconds)
MAX_CPU_TIME_LIMIT=5

# Default Wall (Real) time limit per submission (seconds)
CPU_EXTRA_TIME=0.5
WALL_TIME_LIMIT=5
MAX_WALL_TIME_LIMIT=10

# Default Memory limit (KB) — 128 MB = 128000 KB
MEMORY_LIMIT=128000
# Maximum Memory limit (KB) — 512 MB = 512000 KB
MAX_MEMORY_LIMIT=512000

# Default stack limit (KB) — 64 MB = 64000 KB
STACK_LIMIT=64000
MAX_STACK_LIMIT=128000

# Maximum processes / threads per submission
MAX_PROCESSES_AND_OR_THREADS=64
MAX_MAX_PROCESSES_AND_OR_THREADS=128

# Maximum output size (KB) — 1024 KB = 1 MB
MAX_FILE_SIZE=1024
MAX_MAX_FILE_SIZE=4096

# Number of runs per submission
NUMBER_OF_RUNS=1
MAX_NUMBER_OF_RUNS=1

# ── Judge0 Feature Toggles ───────────────────────────────────────────────────
BASE_URL=/
# Synchronous execution disabled in production — enforce async flow
ENABLE_WAIT_RESULT=false
ENABLE_COMPILER_OPTIONS=true
ENABLE_COMMAND_LINE_ARGUMENTS=true
ENABLE_SUBMISSION_DELETE=false
ENABLE_CALLBACKS=true

# ── Optional API Authentication ──────────────────────────────────────────────
# Uncomment and set if you want token-based auth between MujCode backend and Judge0
# AUTH_TOKEN=generate-a-strong-secret-token-here
