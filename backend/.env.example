# ── MujCode Backend Environment Variables ──────────────────────────────────
# Copy this file to .env and fill in your values.

# Server
PORT=5000
HOST=0.0.0.0
NODE_ENV=development

# Security — REQUIRED! Minimum 32 bytes. Generate with: openssl rand -hex 32
TOKEN_SECRET=<generate-a-strong-32-byte-hex-secret-here>

# CORS — set to your frontend URL (e.g. https://app.example.com)
# Never use '*' in production!
CORS_ORIGIN=https://app.example.com

# Primary Database — PostgreSQL (ACID persistence)
# Format: postgres://user:password@host:port/dbname
POSTGRES_URI=postgres://postgres:<strong-database-password>@localhost:5432/mujcode_db

# File Storage & Secondary Snapshot
DB_FILE=src/data/db.json
UPLOAD_DIR=uploads

# MongoDB — required only for ATS / Placement features
# Format: mongodb://user:password@host:port/dbname
MONGODB_URI=

# Redis — used for cache and sockets
# Format: redis://host:port or redis://:password@host:port
REDIS_URI=redis://localhost:6379

# ── MUJCODE Compiler Engine / Judge0 CE Configuration ──────────────────────────
# MUJCODE Compiler Engine Internal URL (Lightweight 7-Language Runner, port 2359)
COMPILER_ENGINE_URL=http://localhost:2359
# Judge0 CE Fallback URL (if running upstream Judge0 on port 2358)
JUDGE0_URL=http://localhost:2358
# Optional Auth Token if Judge0 was started with AUTH_TOKEN
JUDGE0_AUTH_TOKEN=
# Default execution resource limits
JUDGE0_CPU_TIME_LIMIT=2
JUDGE0_MEMORY_LIMIT=128000
JUDGE0_WALL_TIME_LIMIT=5

# ── Cloudinary (File/Media uploads CDN - Optional) ──────────────────────────
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=


