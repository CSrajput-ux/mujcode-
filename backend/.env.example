# ── MujCode Backend Environment Variables ──────────────────────────────────
# Copy this file to .env and fill in your values.

# Server
PORT=5000
HOST=0.0.0.0
NODE_ENV=development

# Security — CHANGE THIS in production! Generate with: openssl rand -hex 32
TOKEN_SECRET=change-this-to-a-strong-random-secret

# CORS — set to your frontend URL in production (e.g. https://mujcode.in)
CORS_ORIGIN=*

# File Storage
DB_FILE=src/data/db.json
UPLOAD_DIR=uploads

# MongoDB — required only for ATS / Placement features
# Format: mongodb://user:password@host:port/dbname
MONGODB_URI=

# Redis — required only for distributed code compilation queue
# Format: redis://host:port or redis://:password@host:port
REDIS_URI=redis://localhost:6379
